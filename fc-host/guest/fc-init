#!/bin/sh
# =============================================================================
# Agentic Cloud - Phase 5, Step 5.2 (+5.3: read-only root, tmpfs for writable paths)
# PID 1 inside the agent microVM (kernel boot arg: init=/sbin/fc-init).
# Replaces systemd: mounts the basics, then hands over to fc_boot.py, which reads
# this VM's configuration from MMDS and starts the agent server.
# Network (eth0 = 172.16.0.2, gateway 172.16.0.1) is already configured by the
# kernel itself from the boot argument "ip=...", so no network tools are needed.
# =============================================================================
export PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export HOME=/root

mount -t proc     proc     /proc     2>/dev/null
mount -t sysfs    sysfs    /sys      2>/dev/null
mount -t devtmpfs devtmpfs /dev      2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts   devpts   /dev/pts  2>/dev/null
mount -t tmpfs    tmpfs    /dev/shm  2>/dev/null
mount -t tmpfs    tmpfs    /run      2>/dev/null
mount -t tmpfs    tmpfs    /tmp      2>/dev/null
hostname fc-agent 2>/dev/null
# Phase 5.3: the root disk is READ-ONLY (shared by every clone of the golden snapshot).
# Everything the agent writes lives in RAM:
#   /workspace   the agent's L2 workspace (report.md, summaries.json)
#   /home/agent  HOME of uid 10001
#   /run         resolv.conf + hosts (/etc/resolv.conf and /etc/hosts are symlinks into /run)
mount -t tmpfs -o mode=0755,uid=10001,gid=10001,size=256m tmpfs /workspace   2>/dev/null
mount -t tmpfs -o mode=0755,uid=10001,gid=10001,size=64m  tmpfs /home/agent  2>/dev/null

# kernel uptime when init starts = how long the kernel itself took to boot
read UPTIME _ < /proc/uptime
echo "FCBOOT init_start_uptime_s=$UPTIME" > /dev/console

exec /usr/local/bin/python /opt/fc/fc_boot.py
