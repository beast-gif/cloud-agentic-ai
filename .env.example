# Agentic Cloud - secrets for the CONTROL PLANE and the infrastructure.
# Copy this file to .env (which is git-ignored) and fill in real values.
# Agent containers NEVER receive these.
# One KEY=VALUE per line, no spaces around '=', save as ASCII (no BOM).

# Vault master key(s): comma-separated, NEWEST FIRST.
#   Generate one:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Rotation: VAULT_MASTER_KEY=NEW_KEY,OLD_KEY -> restart -> POST /admin/vault/rotate
#             -> VAULT_MASTER_KEY=NEW_KEY -> restart
#   Losing this key makes every stored credential unrecoverable: back it up
#   somewhere OTHER than the database backups.
VAULT_MASTER_KEY=

# Shared secret between the control plane's MCP gateway and the MCP servers.
# The servers reject any request without it, so agents cannot bypass the gateway.
#   Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_GATEWAY_SECRET=

# Mock notify provider: the API keys it has "issued" (key:account, comma-separated).
# Store the same keys in the vault:  PUT /admin/vault/<user>/notify
NOTIFY_ACCOUNTS=ntf_live_7Hk2SuperSecret:amrith,ntf_live_RahulsOwnKey:rahul
